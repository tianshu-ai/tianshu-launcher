{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window + tray.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:tray:default",
    "core:event:default",
    "core:path:default",
    "shell:default",
    "opener:default",
    "opener:allow-open-url"
  ]
}
