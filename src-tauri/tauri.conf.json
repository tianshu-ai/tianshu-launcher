{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tianshu",
  "version": "0.1.8",
  "identifier": "ai.tianshu.launcher",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "node scripts/prepare-payload.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tianshu",
        "width": 480,
        "height": 560,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 400,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "app",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/server": "resources/server",
      "resources/bridge": "resources/bridge",
      "resources/npm": "resources/npm"
    },
    "externalBin": [
      "binaries/node"
    ],
    "macOS": {
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzNzVDNjU4N0Y2MDU4OEIKUldTTFdHQi9XTVoxUXl5V0hGekV0Tit5N1RrV0kyY1VZR1NKWEZBOFRDSDVHZWg3cVdkbjU3MW4K",
      "endpoints": [
        "https://github.com/tianshu-ai/tianshu-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
